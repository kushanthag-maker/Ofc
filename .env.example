# ================= DCL MINI CONFIG =================

# MongoDB Connection String (REQUIRED)
# Get this from MongoDB Atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/dclmini?retryWrites=true&w=majority&appName=Cluster0

# Bot Config
BOT_NAME=DCL MINI
OWNER_NAME=Lucifer
OWNER_NUMBER=94xxxxxxxxx
PREFIX=.

# Pairing mode: "code" or "qr"
PAIRING_METHOD=code

# Server
PORT=3000
SESSION_ID=dcl-mini-session

# Optional: for .ai / .chat / .gpt commands (bring your own key)
OPENAI_API_KEY=

# Optional: for .weather command
WEATHER_API_KEY=

# Optional: for .news command
NEWS_API_KEY=

# Security
ADMIN_PANEL_PASSWORD=changeme123
